# infra/params/exemplo.env.sample — parâmetros operacionais F0 POR ENTE (template).
#
# Copie para infra/params/<ente>.env e ajuste ao CONTRATO do ente. O arquivo real
# NÃO é versionado (.gitignore barra *.env). Os valores abaixo são EXEMPLO — não são
# default de produção: os scripts abortam se a variável não estiver definida
# (não há valor de fábrica embutido no código; ver ADR-0020, item 4).

# --- Identificação do ente --------------------------------------------------
ENTE_SLUG=ente-exemplo                 # rótulo operacional (nomeia stanza/evidência); não há coluna slug no schema — identidade no banco é ente.id/ente.cnpj

# --- Alvos contratuais RPO/RTO (minutos) ------------------------------------
# RPO = perda máxima aceitável de dados; RTO = tempo máximo até restaurar.
# Definidos POR CONTRATO — ajuste ao porte/criticidade do ente.
RPO_ALVO_MIN=15                        # ex.: 15 min (exige PITR/WAL archiving)
RTO_ALVO_MIN=240                       # ex.: 4 h

# --- Política de retenção e imutabilidade -----------------------------------
RETENCAO_FULL=8                        # nº de backups full retidos
RETENCAO_DIAS=90                       # retenção mínima (dias)
IMUTABILIDADE_DIAS=90                  # janela WORM/Object Lock (>= RETENCAO_DIAS)

# --- Object storage da Trilha A (pgBackRest) — coordenadas NÃO sensíveis -----
# Só para METODO=pgbackrest. Credenciais (BACKUP_S3_KEY/SECRET) e a senha de cifra
# (PGBACKREST_CIPHER_PASS) vêm do COFRE, nunca daqui. Aqui só bucket/endpoint/região.
# RESIDÊNCIA (LGPD): a região DEVE ser brasileira — AWS `sa-east-1` (São Paulo) ou a
# região equivalente de nuvem soberana BR. NÃO aponte para região estrangeira: o dado
# contábil/pessoal em repouso não pode cruzar fronteira (ADR-0020; docs/13-nfr §residência).
BACKUP_S3_BUCKET=razao-backup-ente-exemplo
BACKUP_S3_ENDPOINT=s3.sa-east-1.amazonaws.com
BACKUP_S3_REGION=sa-east-1              # região BR — o backup.sh aborta se não for asseverada BR

# --- Agenda (cron) — parametrizável por ente --------------------------------
BACKUP_FULL_CRON="0 2 * * 0"           # full semanal (dom 02:00)
BACKUP_INCR_CRON="0 */1 * * *"         # incremental horário
DRILL_CRON="0 4 * * 1"                 # prova de restauração semanal (seg 04:00)

# --- Conexão da base de origem (backup) -------------------------------------
# Sensíveis (senha, chave de cifra, credenciais de object storage) vêm do COFRE,
# nunca deste arquivo. Aqui só endereço/porta/base não sensíveis.
PGHOST_ORIGEM=localhost
PGPORT_ORIGEM=5432
PGDATABASE_ORIGEM=razao

# --- Alvo scratch da prova de restauração (descartável) ---------------------
PGHOST_SCRATCH=localhost
PGPORT_SCRATCH=5433
PGDATABASE_SCRATCH=razao_drill

# --- Saída de evidência de auditoria ----------------------------------------
EVIDENCIA_DIR=./evidencia-f0           # onde o drill grava o relatório datado
