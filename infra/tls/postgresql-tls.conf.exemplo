# infra/tls/postgresql-tls.conf.exemplo — TLS no servidor PostgreSQL (F0).
# Fragmento para postgresql.conf. Cert/chave vêm do cofre; NÃO versionar a chave.

ssl = on
ssl_cert_file = '/etc/postgresql/tls/server.crt'
ssl_key_file  = '/etc/postgresql/tls/server.key'
ssl_ca_file   = '/etc/postgresql/tls/ca.crt'

# Piso TLS 1.2, preferência 1.3.
ssl_min_protocol_version = 'TLSv1.2'
ssl_prefer_server_ciphers = on
ssl_ciphers = 'HIGH:!aNULL:!MD5:!3DES'

# Habilitar WAL archiving para PITR (RPO baixo) — o comando de archive escreve no
# repositório cifrado do pgBackRest (ver infra/backup). Ajuste ao deploy do ente.
# wal_level = replica
# archive_mode = on
# archive_command = 'pgbackrest --stanza=razao archive-push %p'

# Exija TLS no pg_hba.conf para conexões da aplicação, ex.:
#   hostssl  razao  razao_app  10.0.0.0/8  scram-sha-256
# e NUNCA uma linha `host ... trust` para a base de produção.
