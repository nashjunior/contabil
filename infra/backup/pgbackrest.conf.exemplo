# infra/backup/pgbackrest.conf.exemplo — repo cifrado + imutável (F0).
# Modelo: senha de cifra e credenciais S3 vêm do COFRE, nunca deste arquivo.
# Retenção efetiva é passada por linha de comando a partir de infra/params/<ente>.env.

[global]
# --- Cifra do repositório (backup cifrado em repouso) -----------------------
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=${PGBACKREST_CIPHER_PASS}     # do cofre; NUNCA em claro aqui

# --- Object storage S3-compatível com Object Lock (WORM = imutabilidade) ----
# O bucket deve ter Object Lock em modo COMPLIANCE com retenção >= IMUTABILIDADE_DIAS.
# Nem operador nem credencial comprometida apagam/sobrescrevem dentro da janela.
repo1-type=s3
repo1-s3-bucket=${BACKUP_S3_BUCKET}
repo1-s3-endpoint=${BACKUP_S3_ENDPOINT}
repo1-s3-region=${BACKUP_S3_REGION}
repo1-s3-key=${BACKUP_S3_KEY}                   # do cofre
repo1-s3-key-secret=${BACKUP_S3_SECRET}         # do cofre
# Path SEGREGADO por ente — repositórios físicos de entes distintos não se misturam
# (isolamento multi-ente, ADR-0003). Renderizado por ${ENTE_SLUG} na esteira.
repo1-path=/${ENTE_SLUG}

# --- Operação ---------------------------------------------------------------
compress-type=zst
process-max=4
start-fast=y
log-level-console=info
log-level-file=detail

# Alternativa air-gapped (ente sem object storage): use a trilha `dump` do
# backup.sh (pg_dump + age) e exporte o artefato para mídia offline.

# Uma stanza POR ENTE: o nome da seção é o ENTE_SLUG (o backup.sh invoca
# `pgbackrest --stanza="$ENTE_SLUG"`). Renderizado pela esteira — cada ente tem seu
# arquivo/seção; a seção literal `[razao]` abaixo é só o exemplo do ente-modelo.
[${ENTE_SLUG}]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
pg1-user=postgres
