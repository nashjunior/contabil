# VITE_API_MODE=mock (default) usa MSW contra frontend/openapi/contrato-provisorio.yaml —
# nao ha backend Spring Boot real acessivel neste ambiente (gap, ver README/RAZ-120).
# Trocar para VITE_API_MODE=real quando houver um backend rodavel.
VITE_API_MODE=mock

# Base URL da API real (usado so quando VITE_API_MODE=real). Ajustar para o host do
# backend (ex.: http://localhost:8080) quando ele existir.
# VITE_API_BASE_URL=http://localhost:8080
