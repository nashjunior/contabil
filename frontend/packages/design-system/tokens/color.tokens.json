    },
    "pii": {
      "maskBg": { "$type": "color", "$value": "{color.neutral.100}" },
      "maskFg": { "$type": "color", "$value": "{color.neutral.700}" }
    },
    "$extensions": {
      "contabil.contrastPairs": [
        { "fg": "{color.text.primary}", "bg": "{color.bg.surface}", "context": "texto normal", "minRatio": 4.5 },
        { "fg": "{color.text.secondary}", "bg": "{color.bg.surface}", "context": "texto normal", "minRatio": 4.5 },
        { "fg": "{color.text.onBrand}", "bg": "{color.brand.default}", "context": "texto em botao/UI", "minRatio": 4.5 },
        { "fg": "{color.state.success.fg}", "bg": "{color.state.success.bg}", "context": "badge/chip", "minRatio": 4.5 },
        { "fg": "{color.state.warning.fg}", "bg": "{color.state.warning.bg}", "context": "badge/chip", "minRatio": 4.5 },
        { "fg": "{color.state.danger.fg}", "bg": "{color.state.danger.bg}", "context": "badge/chip", "minRatio": 4.5 },
        { "fg": "{color.state.info.fg}", "bg": "{color.state.info.bg}", "context": "badge/chip", "minRatio": 4.5 },
        { "fg": "{color.pii.maskFg}", "bg": "{color.pii.maskBg}", "context": "chip de CPF mascarado", "minRatio": 4.5 }
