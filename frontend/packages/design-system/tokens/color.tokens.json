      "100": { "$type": "color", "$value": "#f1f5f9", "$description": "REAL — via bg/inset, bg/disabled, state/neutral-bg, pii/mask-bg (VariableID:2:5/2:6/2:21/2:36)." },
      "200": { "$type": "color", "$value": "#e2e8f0", "$description": "INFERIDO, NÃO CONFIRMADO — nenhum token semântico faz alias para este passo (nada na página Foundations o expõe), então não há fill renderizado para ler. Os 9 outros passos de neutral bateram exatamente com a paleta 'slate' do Tailwind CSS; este valor é a continuação dessa mesma progressão, não um valor lido do Figma. Substituir se/quando a Figma Variables REST API (GET /v1/files/:key/variables/local, requer escopo file_variables:read que o token atual não tem — ver README) ficar disponível." },
      "300": { "$type": "color", "$value": "#cbd5e1", "$description": "REAL — via border/default, state/neutral-border (VariableID:2:14/2:23)." },
      "400": { "$type": "color", "$value": "#94a3b8", "$description": "REAL — via text/disabled, border/strong (VariableID:2:11/2:15)." },
      "500": { "$type": "color", "$value": "#64748b", "$description": "REAL — via text/tertiary (VariableID:2:10)." },
      "600": { "$type": "color", "$value": "#475569", "$description": "REAL — via text/secondary (VariableID:2:9)." },
      "700": { "$type": "color", "$value": "#334155", "$description": "REAL — via state/neutral-fg, pii/mask-fg (VariableID:2:22/2:37)." },
      "900": { "$type": "color", "$value": "#0f172a", "$description": "REAL — via text/primary, bg/overlay-scrim (VariableID:2:8/2:7)." }
    },
