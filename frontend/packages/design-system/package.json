{
  "name": "@siafic/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/tokens/theme.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "prepare": "node scripts/check-contrast.mjs && node scripts/build-tokens.mjs",
    "tokens:contrast": "node scripts/check-contrast.mjs",
    "tokens:build": "npm run tokens:contrast && node scripts/build-tokens.mjs",
    "typecheck": "npm run tokens:build && tsc --noEmit",
    "build": "npm run tokens:build && tsc -p tsconfig.build.json && node scripts/copy-theme-css.mjs"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "style-dictionary": "^5.5.0",
    "typescript": "^5.9.3"
  }
}
