{
  "name": "@siafic/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/tokens/theme.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "prepare": "node scripts/check-contrast.mjs && node scripts/build-tokens.mjs",
    "tokens:contrast": "node scripts/check-contrast.mjs",
    "tokens:build": "npm run tokens:contrast && node scripts/build-tokens.mjs",
    "typecheck": "npm run tokens:build && tsc --noEmit",
    "build": "npm run tokens:build && tsc -p tsconfig.build.json && node scripts/copy-theme-css.mjs",
    "prestorybook": "npm run tokens:build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run tokens:build",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "style-dictionary": "^5.5.0",
    "typescript": "^5.9.3",
    "storybook": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5"
  }
}
